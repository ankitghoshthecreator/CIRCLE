# Groq API Configuration for Critic Agent
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Data Generator Configuration (Qwen 2.5 via local Ollama)
GENERATOR_API_BASE=http://localhost:11434/v1
GENERATOR_MODEL=qwen2.5

# Trainer & Hardware Settings
BASE_MODEL_NAME=gpt2
TRAIN_BATCH_SIZE=1
GRADIENT_ACCUMULATION_STEPS=8
LEARNING_RATE=2e-4
DEVICE=cuda
VRAM_LIMIT_GB=4

# Storage & Checkpointing
CHECKPOINT_DIR=./trainer/checkpoints
DATASET_DIR=./data

# Orchestrator Configuration
KUBECONFIG_PATH=~/.kube/config
K8S_NAMESPACE=circle
CURRENT_STAGE=1
MAX_ITERATIONS_PER_STAGE=3
